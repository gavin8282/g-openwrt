#!/bin/sh

if [ -d /www/luci-static/resources/view/network ]; then
	cp -f /usr/share/luci-app-mtwifi-cfg/wireless-mtk.js /www/luci-static/resources/view/network/wireless.js
fi

if [ -d /usr/share/luci/menu.d ]; then
	cp -f /usr/share/luci-app-mtwifi-cfg/luci-mod-status.json /usr/share/luci/menu.d/luci-mod-status.json
fi

for luci_network_js in /www/luci-static/resources/network.js /www/luci-static/resources/tools/network.js; do
	if [ -f "$luci_network_js" ]; then
		if ! grep -sq 'ra\[xiyez\]' "$luci_network_js" ; then
			sed -i 's#/\^wlan[^,]*,#& /^ra[xiyez]?[0-9]+/, /^apcli[xiyez]?[0-9]+/,#' "$luci_network_js"
		fi
		sed -i "s#return this.ubus('net', 'config', 'bssid')#return this.ubus('net', 'iwinfo', 'bssid') || this.ubus('net', 'config', 'bssid') || this.ubus('net', 'bssid')#" "$luci_network_js"
		sed -i "s#return this.ubus('dev', 'disabled') || this.get('disabled') == '1';#const _devn = this.getWifiDeviceName ? this.getWifiDeviceName() : this.getName(); if (uci.get('wireless', _devn, 'type') == 'mtwifi') return (this.get('disabled') == '1' || (this.getWifiDeviceName && uci.get('wireless', _devn, 'disabled') == '1')); return this.ubus('dev', 'disabled') || this.get('disabled') == '1';#g" "$luci_network_js"
		sed -i "s#if (L.isObject(_state.radios\[this.sid\]))#if (this.get('type') == 'mtwifi') return (this.get('disabled') != '1'); if (L.isObject(_state.radios\[this.sid\]))#" "$luci_network_js"
		sed -i "s#const device = this.getDevice();#if (uci.get('wireless', this.getWifiDeviceName(), 'type') == 'mtwifi') return (this.get('disabled') != '1' && uci.get('wireless', this.getWifiDeviceName(), 'disabled') != '1'); const device = this.getDevice();#" "$luci_network_js"
	fi
done

LUCI_STATUS_WIFI="/www/luci-static/resources/view/status/include/60_wifi.js"
if [ -f "$LUCI_STATUS_WIFI" ]; then
	sed -i "s#const is_assoc = (net.getBSSID() != '00:00:00:00:00:00' && net.getChannel() && !net.isDisabled());#const is_assoc = ((net.getActiveBSSID() || net.getBSSID()) != '00:00:00:00:00:00' && (net.getChannel() || net.getFrequency()) && !net.isDisabled());#" "$LUCI_STATUS_WIFI"
fi

# Ensure all mtwifi devices and ifaces in /etc/config/wireless are enabled by default
if [ -f /etc/config/wireless ]; then
	for sec in $(uci show wireless 2>/dev/null | grep -E "=wifi-device|=wifi-iface" | cut -d'.' -f2 | cut -d'=' -f1); do
		if [ "$(uci -q get wireless.$sec.disabled)" = "1" ]; then
			hwtype="$(uci -q get wireless.$sec.type)"
			dev="$(uci -q get wireless.$sec.device)"
			if [ "$hwtype" = "mtwifi" ] || [ -n "$dev" ]; then
				uci -q delete wireless.$sec.disabled
			fi
		fi
	done
	uci -q commit wireless
fi

exit 0
