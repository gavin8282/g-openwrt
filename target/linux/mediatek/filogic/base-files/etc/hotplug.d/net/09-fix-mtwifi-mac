#!/bin/sh

. /lib/functions.sh
. /lib/functions/system.sh

set_macs_to_dat()
{
    local b0_mac="$1"
    local b1_mac="$2"

    is_valid_unicast_mac "$b0_mac" || b0_mac=""
    is_valid_unicast_mac "$b1_mac" || b1_mac=""

    local b0_dat="$(l1util if2dat ra0 2>/dev/null)"
    local b1_dat="$(l1util if2dat rax0 2>/dev/null)"

    [ -z "$b0_dat" -o ! -f "$b0_dat" ] && b0_dat="/etc/wireless/mediatek/mt7981.dbdc.b0.dat"
    [ -z "$b1_dat" -o ! -f "$b1_dat" ] && b1_dat="/etc/wireless/mediatek/mt7981.dbdc.b1.dat"

    if [ -f "$b0_dat" ] && [ -n "$b0_mac" ]; then
        local mac="$(sed -n 's/^MacAddress=//p' "$b0_dat")"

        if ! is_valid_unicast_mac "$mac"; then
            sed -i '/^MacAddress=/d' "$b0_dat"
            echo "MacAddress=$b0_mac" >> "$b0_dat"
        fi
    fi
    if [ -f "$b1_dat" ] && [ -n "$b1_mac" ]; then
        local mac="$(sed -n 's/^MacAddress=//p' "$b1_dat")"

        if ! is_valid_unicast_mac "$mac"; then
            sed -i '/^MacAddress=/d' "$b1_dat"
            echo "MacAddress=$b1_mac" >> "$b1_dat"
        fi
    fi
}

mtwifi_set_macs()
{
    case $(board_name) in
	acer,predator-w6x-stock|\
	acer,predator-w6x-ubootmod)
		local base_mac="$(mtd_get_mac_ascii u-boot-env ethaddr)"
        local b0_mac="$(macaddr_add $base_mac 2)"
        local b1_mac="$(macaddr_add $base_mac 3)"

        set_macs_to_dat "$b0_mac" "$b1_mac"
		;;
    cetron,ct3003|\
    cetron,ct3003-112m|\
    cetron,ct3003-ubootmod)
        local base_mac=""
        for key in MAC_ADDRESS mac MAC ethaddr; do
            base_mac=$(mtd_get_mac_ascii art "$key" 2>/dev/null)
            is_valid_unicast_mac "$base_mac" && break
            base_mac=""
        done
        if [ -z "$base_mac" ]; then
            for key in ethaddr mac MAC; do
                base_mac=$(mtd_get_mac_ascii u-boot-env "$key" 2>/dev/null)
                is_valid_unicast_mac "$base_mac" && break
                base_mac=""
            done
        fi
        if [ -z "$base_mac" ]; then
            for key in mac MAC lanMac ethaddr; do
                base_mac=$(mtd_get_mac_ascii Factory "$key" 2>/dev/null)
                is_valid_unicast_mac "$base_mac" && break
                base_mac=""
            done
        fi
        if [ -z "$base_mac" ]; then
            for ofs in 0x4 0x0 0x24 0x2a; do
                base_mac=$(mtd_get_mac_binary Factory "$ofs" 2>/dev/null)
                is_valid_unicast_mac "$base_mac" && break
                base_mac=""
            done
        fi
        if [ -z "$base_mac" ]; then
            for ofs in 0 0x7b 0x4; do
                base_mac=$(mtd_get_mac_binary art "$ofs" 2>/dev/null)
                is_valid_unicast_mac "$base_mac" && break
                base_mac=""
            done
        fi
        if [ -z "$base_mac" ] && [ -f /sys/class/net/eth0/address ]; then
            base_mac=$(cat /sys/class/net/eth0/address 2>/dev/null)
            is_valid_unicast_mac "$base_mac" || base_mac=""
        fi
        if [ -z "$base_mac" ]; then
            local seed=""
            if [ -f /etc/machine-id ]; then
                seed=$(cat /etc/machine-id 2>/dev/null)
            elif [ -f /proc/sys/kernel/random/boot_id ]; then
                seed=$(cat /proc/sys/kernel/random/boot_id 2>/dev/null)
            fi
            [ -z "$seed" ] && seed="cetron-ct3003"
            local h=$(echo -n "$seed" | md5sum | cut -c1-10)
            base_mac="02:${h:0:2}:${h:2:2}:${h:4:2}:${h:6:2}:${h:8:2}"
        fi

        local b0_mac="$(macaddr_add "$base_mac" 1)"
        local b1_mac="$(macaddr_add "$base_mac" 2)"

        set_macs_to_dat "$b0_mac" "$b1_mac"
        ;;
    clx,s20l|\
    clx,s20p)
        local b0_mac="$(mmc_get_mac_binary factory 0x4)"
        local b1_mac="$(mmc_get_mac_binary factory 0x30)"

        set_macs_to_dat "$b0_mac" "$b1_mac"
        ;;
    cudy,ap3000outdoor-v1|\
	cudy,ap3000-v1|\
	cudy,m3000-v1|\
	cudy,re3000-v1|\
	cudy,tr3000-256mb-v1|\
	cudy,tr3000-v1|\
	cudy,tr3000-v1-ubootmod|\
    cudy,tr3000-v1-mtkuboot|\
	cudy,wbr3000uax-v1|\
	cudy,wbr3000uax-v1-ubootmod|\
	cudy,wr3000e-v1|\
	cudy,wr3000s-v1|\
	cudy,wr3000h-v1|\
	cudy,wr3000p-v1|\
	cudy,wr3000-v1)
		local b0_mac="$(mtd_get_mac_binary bdinfo 0xde00)"
        local b1_mac="$(macaddr_setbit_la $(macaddr_add $b0_mac 1))"

        set_macs_to_dat "$b0_mac" "$b1_mac"
		;;
    h3c,magic-nx30-pro|\
    h3c,magic-nx30-pro-mtkuboot)
        local base_mac="$(mtd_get_mac_ascii pdt_data_1 ethaddr)"
        local b0_mac="$(macaddr_add $base_mac 2)"
        local b1_mac="$(macaddr_add $base_mac 3)"

        set_macs_to_dat "$b0_mac" "$b1_mac"
        ;;
    qihoo,360t7)
        local base_mac="$(mtd_get_mac_ascii factory lanMac)"
        local b0_mac="$(macaddr_add $base_mac 2)"
        local b1_mac="$(macaddr_add $base_mac 3)"

        set_macs_to_dat "$b0_mac" "$b1_mac"
        ;;
    ruijie,rg-x30e-pro|\
    ruijie,rg-x60-new-mtkuboot)
        local base_mac="$(mtd_get_mac_ascii product_info ethaddr)"
        local b0_mac="$(macaddr_add $base_mac 2)"
        local b1_mac="$(macaddr_add $base_mac 3)"
        
        set_macs_to_dat "$b0_mac" "$b1_mac"
        ;;
    ruijie,rg-x60-new-ubi)
        local voldev="/dev/$(grep -l "product_info" /sys/class/ubi/ubi0_*/name | cut -d/ -f5)"
        local base_mac="$(strings $voldev | grep "^ethaddr=" | cut -d'=' -f2)"
        local b0_mac="$(macaddr_add $base_mac 2)"
        local b1_mac="$(macaddr_add $base_mac 3)"
        
        set_macs_to_dat "$b0_mac" "$b1_mac"
        ;;
    esac
}

case "${ACTION}" in
    add)
        case "${INTERFACE}" in
            ra*|rax*)
                mtwifi_set_macs
                ;;
        esac
        ;;
esac
