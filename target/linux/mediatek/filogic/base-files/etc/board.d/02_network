mtk_factory_write_mac()
{
	local part_name="$1"
	local offset="$2"
	local macaddr="$3"

	is_valid_unicast_mac "$macaddr" || return 1
	macaddr="$(macaddr_canonicalize "$macaddr")"

	local cur_mac="$(macaddr_canonicalize "$(mtd_get_mac_binary "$part_name" "$offset" 2>/dev/null)")"
	[ "$cur_mac" = "$macaddr" ] && return 0

	local part="$(find_mtd_part "$part_name")"
	[ -n "$part" ] || return 1

	dd if="$part" of="/tmp/Factory.backup" 2>/dev/null || return 1
	data_2bin "${macaddr//:/}" | dd of="/tmp/Factory.backup" conv=notrunc bs=1 seek="$(($offset))" count=6 2>/dev/null
	mtd write "/tmp/Factory.backup" "$part_name"
	rm -f "/tmp/Factory.backup"
}

mediatek_setup_macs()
{
	local board="$1"
	local lan_mac=""
	local wan_mac=""
	local label_mac=""
	local b0dat="$(l1dat if2dat ra0)"
	local b1dat="$(l1dat if2dat rax0)"
	case $board in
	airpi,ap3000m)
		lan_mac=$(macaddr_generate_from_mmc_cid mmcblk0)
		wan_mac=$(macaddr_add "$lan_mac" 1)
		;;
	acer,predator-w6|\
	acer,predator-w6d|\
	acer,vero-w6m)
		wan_mac=$(mmc_get_mac_ascii u-boot-env WANMAC)
		lan_mac=$(mmc_get_mac_ascii u-boot-env LANMAC)
		;;
	cudy,tr3000-v1)
		wan_mac=$(mtd_get_mac_binary bdinfo 0xde00)
                lan_mac=$(macaddr_add "$wan_mac" 1)
		;;
	bananapi,bpi-r3|\
	bananapi,bpi-r3-mini|\
	bananapi,bpi-r4)
		wan_mac=$(macaddr_add $(cat /sys/class/net/eth0/address) 1)
		;;
	cetron,ct3003|\
	cetron,ct3003-112m|\
	cetron,ct3003-ubootmod)
		# 1. Try ASCII from art
		for key in MAC_ADDRESS mac MAC ethaddr; do
			lan_mac=$(mtd_get_mac_ascii art "$key" 2>/dev/null)
			is_valid_unicast_mac "$lan_mac" && break
			lan_mac=""
		done

		# 2. Try ASCII from u-boot-env
		if [ -z "$lan_mac" ]; then
			for key in ethaddr mac MAC; do
				lan_mac=$(mtd_get_mac_ascii u-boot-env "$key" 2>/dev/null)
				is_valid_unicast_mac "$lan_mac" && break
				lan_mac=""
			done
		fi

		# 3. Try ASCII / binary from Factory
		if [ -z "$lan_mac" ]; then
			for key in mac MAC lanMac ethaddr; do
				lan_mac=$(mtd_get_mac_ascii Factory "$key" 2>/dev/null)
				is_valid_unicast_mac "$lan_mac" && break
				lan_mac=""
			done
		fi
		if [ -z "$lan_mac" ]; then
			for ofs in 0x4 0x0 0x24 0x2a; do
				lan_mac=$(mtd_get_mac_binary Factory "$ofs" 2>/dev/null)
				is_valid_unicast_mac "$lan_mac" && break
				lan_mac=""
			done
		fi

		# 4. Try binary from art
		if [ -z "$lan_mac" ]; then
			for ofs in 0 0x7b 0x4; do
				lan_mac=$(mtd_get_mac_binary art "$ofs" 2>/dev/null)
				is_valid_unicast_mac "$lan_mac" && break
				lan_mac=""
			done
		fi

		# 5. Try existing eth0 sysfs address
		if [ -z "$lan_mac" ] && [ -f /sys/class/net/eth0/address ]; then
			lan_mac=$(cat /sys/class/net/eth0/address 2>/dev/null)
			is_valid_unicast_mac "$lan_mac" || lan_mac=""
		fi

		# 6. Guaranteed deterministic fallback: locally administered unicast MAC
		if [ -z "$lan_mac" ]; then
			local seed=""
			if [ -f /etc/machine-id ]; then
				seed=$(cat /etc/machine-id 2>/dev/null)
			elif [ -f /proc/sys/kernel/random/boot_id ]; then
				seed=$(cat /proc/sys/kernel/random/boot_id 2>/dev/null)
			fi
			[ -z "$seed" ] && seed="cetron-ct3003"
			local h=$(echo -n "$seed" | md5sum | cut -c1-10)
			lan_mac="02:${h:0:2}:${h:2:2}:${h:4:2}:${h:6:2}:${h:8:2}"
		fi

		wan_mac=$(macaddr_add "$lan_mac" 3)
		label_mac=$lan_mac
		local wifi_mac="$(macaddr_add "$lan_mac" 1)"
		mtk_factory_write_mac Factory 0x4 "$wifi_mac"

		local b0_dat="$(l1util if2dat ra0 2>/dev/null)"
		local b1_dat="$(l1util if2dat rax0 2>/dev/null)"
		[ -z "$b0_dat" -o ! -f "$b0_dat" ] && b0_dat="/etc/wireless/mediatek/mt7981.dbdc.b0.dat"
		[ -z "$b1_dat" -o ! -f "$b1_dat" ] && b1_dat="/etc/wireless/mediatek/mt7981.dbdc.b1.dat"
		[ -f "$b0_dat" ] && sed -i '/^MacAddress=/d' "$b0_dat"
		[ -f "$b1_dat" ] && sed -i '/^MacAddress=/d' "$b1_dat"
		b0dat=""
		b1dat=""
		;;
	h3c,magic-nx30-pro|\
	h3c,magic-nx30-pro-nmbm)
		wan_mac=$(mtd_get_mac_ascii pdt_data_1 ethaddr)
		lan_mac=$(macaddr_add "$wan_mac" 1)
		label_mac=$wan_mac
		;;
	mercusys,mr80x-v3)
		mac_dirty=$(cat "/tmp/tp_data/default-mac" | sed -n 's/^'"MAC"'://p')
		label_mac=$(macaddr_canonicalize "$mac_dirty")
		lan_mac=$label_mac
		wan_mac=$(macaddr_add "$lan_mac" 1)
		;;
	mercusys,mr90x-v1|\
	tplink,re6000xd)
		label_mac=$(get_mac_binary "/tmp/tp_data/default-mac" 0)
		lan_mac=$label_mac
		;;
	netgear,wax220)
		lan_mac=$(mtd_get_mac_ascii u-boot-env mac)
		label_mac=$lan_mac
		;;
	nradio,c8-668gl)
		lan_mac=$(mmc_get_mac_ascii bdinfo "fac_mac ")
		wan_mac=$(macaddr_add "$lan_mac" 2)
		label_mac=$lan_mac
		;;
	qihoo,360t7)
		lan_mac=$(mtd_get_mac_ascii factory lanMac)
		wan_mac=$(macaddr_add "$lan_mac" 1)
		label_mac=$wan_mac
		;;
	ruijie,ew-6000gx-pro*|\
	ruijie,rg-x60*)
		label_mac=$(mtd_get_mac_ascii product_info ethaddr)
		wan_mac=$label_mac
		lan_mac=$(macaddr_add "$label_mac" 1)
		;;
	yvr,x6)
		wan_mac=$(mtd_get_mac_ascii Factory_info MAC)
		lan_mac=$(macaddr_add $wan_mac 1)
		label_mac=$lan_mac
		;;
	sl,3000-emmc)
 		lan_mac=$(mmc_get_mac_binary factory 0x04)		
 		wan_mac=$(macaddr_add "$lan_mac" -2)
 		label_mac=$lan_mac
 		;;
	philips,hy3000)
		lan_mac=$(mmc_get_mac_binary factory 0x74)
		wan_mac=$(macaddr factory $lan_mac 1)
		label_mac=$wan_mac
		;;
    sn,r1)
		lan_mac=$(mmc_get_mac_binary factory 0x2a)
		wan_mac=$(mmc_get_mac_binary factory 0x24)
		label_mac=$wan_mac
		;;
	xiaomi,mi-router-ax3000t|\
	xiaomi,mi-router-ax3000t-mtkuboot|\
	xiaomi,mi-router-ax3000t-ubootmod|\
	xiaomi,mi-router-wr30u-stock|\
	xiaomi,mi-router-wr30u-ubootmod|\
	xiaomi,redmi-router-ax6000-stock|\
	xiaomi,redmi-router-ax6000-ubootmod)
		wan_mac=$(mtd_get_mac_ascii Bdata ethaddr_wan)
		label_mac=$wan_mac
		;;
	umi,uax3000e)
		lan_mac=$(mmc_get_mac_binary factory 0x2A)
		wan_mac=$(mmc_get_mac_binary factory 0x04)
		;;
	yuncore,ax835)
		label_mac=$(mtd_get_mac_binary "Factory" 0x4)
		;;
	openfi,6c*)
		lan_mac=$(macaddr_add $(cat /sys/class/net/eth1/address) 1)
		;;
	wirelesstag,zx7981pd|\
	wirelesstag,zx7981pd-ubootmod)
		label_mac=$(mtd_get_mac_binary wtinfo 10)
		lan_mac=$label_mac
		wan_mac=$(macaddr_add "$label_mac" 1)
		;;
	mediatek,7981r128)
		local label_mac=$(mtd_get_mac_binary Factory 0x4)
		lan_mac=$(macaddr_add $label_mac 1)
		wan_mac=$(macaddr_add $label_mac -1)
		;;
	esac

	if [ -n "$label_mac" ]; then
		base_mac="$label_mac"
	elif [ -n "$wan_mac" ]; then
		base_mac="$wan_mac"
	elif [ -n "$lan_mac" ]; then
		base_mac="$lan_mac"
	else
		base_mac=$(cat /sys/class/net/eth0/address)
	fi

	if [ -f ${b0dat} ] && ! grep -q "MacAddress=" ${b0dat}; then
			local b0mac="$(macaddr_add "$base_mac" 3)"
			echo "MacAddress=$b0mac" >> ${b0dat}
		fi
	if [ -f ${b1dat} ] && ! grep -q "MacAddress=" ${b1dat}; then
			local b1mac="$(macaddr_add "$base_mac" 4)"
			echo "MacAddress=$b1mac" >> ${b1dat}
	fi

	[ -n "$lan_mac" ] && ucidef_set_interface_macaddr "lan" $lan_mac
	[ -n "$wan_mac" ] && ucidef_set_interface_macaddr "wan" $wan_mac
	[ -n "$label_mac" ] && ucidef_set_label_macaddr $label_mac
}

board_config_update
board=$(board_name)
mediatek_setup_interfaces $board
mediatek_setup_macs $board
board_config_flush

exit 0
